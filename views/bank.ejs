<!DOCTYPE html>
<html>
<head>
    <title>Bank Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="navbar">
    <div class="logo">Bulldog ETH Bank</div>
    <div>
        <% if (isAdmin) { %>
            <a href="/admin">Admin</a>
        <% } %>
        <a href="/logout">Logout</a>
    </div>
</div>

<div class="container dashboard-container">

    <div class="dashboard-header">
        <div>
            <p class="eyebrow">Simulated Web3 Banking Dashboard</p>
            <h1>Welcome, <%= user.username %></h1>
        </div>
    </div>

    <div class="card wallet-card">
        <h3>MetaMask Wallet</h3>
        <p class="card-text">Connect MetaMask to display your wallet address, network, and live wallet balance.</p>

        <button id="connectWalletBtn" type="button">Connect MetaMask</button>

        <p><strong>Wallet:</strong> <span id="walletAddress">Not connected</span></p>
        <p><strong>Network:</strong> <span id="networkName">Not connected</span></p>
        <p><strong>Wallet Balance:</strong> <span id="walletBalance">0 ETH</span></p>
    </div>

    <div class="balance-box">
        <p class="eyebrow">Simulated Bank Balance</p>
        <h1 class="balance"><%= Number(user.ethBalance).toFixed(4) %> ETH</h1>
    </div>

    <div class="dashboard-grid">
        <div class="card">
            <h3>Deposit Ethereum</h3>
            <p class="card-text">Add simulated ETH credit to your bank balance.</p>

            <form id="depositForm">
                <input name="amount" id="depositAmount" type="number" step="0.0001" min="0.0001" placeholder="Enter ETH amount" required>
                <input type="hidden" name="walletAddress" class="walletInput">
                <input type="hidden" name="networkName" class="networkInput">
                <button type="submit">Deposit ETH</button>
            </form>
        </div>

        <div class="card">
            <h3>Withdraw Ethereum</h3>
            <p class="card-text">Withdraw simulated ETH credit from your bank balance.</p>

            <form id="withdrawForm">
                <input name="amount" id="withdrawAmount" type="number" step="0.0001" min="0.0001" placeholder="Enter ETH amount" required>
                <input type="hidden" name="walletAddress" class="walletInput">
                <input type="hidden" name="networkName" class="networkInput">
                <button type="submit">Withdraw ETH</button>
            </form>
        </div>
    </div>

    <div class="card">
        <h3>Transaction History</h3>

        <% if (transactions.length === 0) { %>
            <p class="card-text" id="noTransactionsMessage">No transactions yet.</p>
        <% } else { %>
            <p class="card-text" id="noTransactionsMessage" style="display:none;">No transactions yet.</p>
        <% } %>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Hash</th>
                    </tr>
                </thead>

                <tbody id="txTableBody">
                    <% transactions.forEach(tx => { %>
                    <tr>
                        <td><%= tx.type %></td>
                        <td><%= Number(tx.amount).toFixed(4) %> ETH</td>
                        <td><span class="status-pill"><%= tx.status %></span></td>
                        <td class="hash-cell"><%= tx.hash %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/ethers@6.13.4/dist/ethers.umd.min.js"></script>
<script src="/bank.js"></script>

</body>
</html>
